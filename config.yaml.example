# The proxy serves HTTPS using a CA and server certificate generated on first startup.
# Copy tls/ca.pem to each client trust store; retain the tls directory across restarts.
listen:
  address: 0.0.0.0:3030
  tls:
    certificate_directory: tls
    # Add every DNS name or IP address clients use to reach this proxy.
    server_names:
      - localhost
      - api-proxy

# Optional CrowdStrike Falcon collection endpoint. Enable to serve GET /crowdstrike.
crowdstrike:
  enabled: false
  base_url: https://api.crowdstrike.com
  timeout_seconds: 120
  page_size: 100
  lookback_days: 7
  rate_limit_retries: 3
  features:
    zta: true
    alerts: true
    detections: true
    incidents: true
    vulnerability_summary: true
    policies: true
    host_groups: true
    unmanaged_assets: true

target:
  base_url: https://YOUR_SERVICENOW_INSTANCE.service-now.com
  timeout_seconds: 300
  # Optional PEM CA bundle. In the container, mount one at this path if the
  # upstream uses a private CA. The image already contains its normal CA set.
  # ca_bundle_path: /etc/ssl/certs/custom-ca-bundle.pem

# Choose exactly one pagination strategy per running proxy.
pagination:
  mode: offset
  offset_parameter: sysparm_offset
  page_size_parameter: sysparm_limit
  start_offset: 0
  page_size: 10

response:
  # RFC 6901 JSON Pointer to the array to consolidate.
  array_path: /result
  # terminate: close with an error if a later page fails
  # complete: close the JSON document with data collected so far
  error_policy: terminate

